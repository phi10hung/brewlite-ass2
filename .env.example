# Mẫu biến môi trường của BrewLite.
# Chép tệp này thành .env (cùng thư mục) rồi điền giá trị. KHÔNG commit tệp .env.
# Production không dùng tệp này: biến của API đặt trong Render, biến của web đặt trong Vercel.
# Chi tiết: docs/architecture/adr/007-quan-ly-cau-hinh.md

# ===== Database (Docker Compose dùng các biến này) =====
# Giá trị dưới đây chỉ dùng ở máy cá nhân.
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite

# ===== API (apps/api) =====
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public
# Khóa ký JWT: đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=doi-gia-tri-nay
JWT_EXPIRES_IN=1d
# Địa chỉ web được phép gọi API
CORS_ORIGIN=http://localhost:3000
# Hạn thanh toán của đơn (phút)
ORDER_PAYMENT_MINUTES=5
# APP_VERSION do pipeline CD ghi vào image lúc build, ở máy cá nhân không cần đặt

# ===== Thanh toán VNPay Sandbox =====
# Khóa thật xin ở trưởng nhóm, chỉ điền vào .env; không commit, không gửi lên chat nhóm.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_RETURN_URL=http://localhost:3000/payment/result

# ===== Web (apps/web) =====
# Địa chỉ API, ghi vào bản build. Không đặt khóa bí mật vào biến có tiền tố NEXT_PUBLIC_.
NEXT_PUBLIC_API_URL=http://localhost:4000