generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  STAFF
}

enum Size {
  S
  M
  L
}

enum OrderStatus {
  PENDING
  PAYMENT_FAILED
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum LoyaltyType {
  EARN
  REVOKE
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  name          String
  role          Role     @default(CUSTOMER)
  loyaltyPoints Int      @default(0)
  createdAt     DateTime @default(now())

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String
  category    String
  price       Int
  imageUrl    String

  recipes    Recipe[]
  orderItems OrderItem[]
}

model Topping {
  id    Int    @id @default(autoincrement())
  name  String @unique
  price Int

  recipes ToppingRecipe[]
}

model Ingredient {
  id      Int    @id @default(autoincrement())
  name    String @unique
  unit    String
  stock   Int
  version Int    @default(0)

  recipes          Recipe[]
  toppingRecipes   ToppingRecipe[]
  orderIngredients OrderIngredient[]
}

model Recipe {
  productId    Int
  ingredientId Int
  amount       Int

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([productId, ingredientId])
}

model ToppingRecipe {
  toppingId    Int
  ingredientId Int
  amount       Int

  topping    Topping    @relation(fields: [toppingId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([toppingId, ingredientId])
}

model Order {
  id            Int           @id @default(autoincrement())
  code          String        @unique
  status        OrderStatus   @default(PENDING)
  subtotal      Int
  discount      Int           @default(0)
  total         Int
  paymentMethod PaymentMethod
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  userId        Int
  promotionId   Int?

  user                User                 @relation(fields: [userId], references: [id])
  promotion           Promotion?           @relation(fields: [promotionId], references: [id])
  items               OrderItem[]
  ingredients         OrderIngredient[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String
  size        Size
  toppings    String[]
  quantity    Int
  unitPrice   Int
  lineTotal   Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model OrderIngredient {
  orderId      Int
  ingredientId Int
  amount       Int

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([orderId, ingredientId])
}

model Payment {
  id             Int           @id @default(autoincrement())
  orderId        Int
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Int
  idempotencyKey String        @unique
  txnRef         String        @unique
  payUrl         String?
  transactionNo  String?
  refundStatus   RefundStatus?
  createdAt      DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Promotion {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  type      DiscountType
  value     Int
  minOrder  Int          @default(0)
  active    Boolean      @default(true)
  expiresAt DateTime

  orders Order[]
}

model LoyaltyTransaction {
  id        Int         @id @default(autoincrement())
  type      LoyaltyType
  points    Int
  createdAt DateTime    @default(now())
  userId    Int
  orderId   Int

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@unique([orderId, type])
}
