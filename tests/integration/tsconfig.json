{
  "extends": "../../apps/api/tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "incremental": false,
    // tests/integration không có node_modules riêng: tìm thư viện trong apps/api (ADR 001)
    "typeRoots": [
      "../../apps/api/node_modules/@types",
      "../../apps/api/node_modules"
    ],
    "paths": {
      "*": [
        "../../apps/api/node_modules/@types/*",
        "../../apps/api/node_modules/*"
      ]
    }
  },
  "include": ["**/*.ts"]
}
